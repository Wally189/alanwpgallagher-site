<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<meta property="og:title" content="{{ og_title | default(title) }}" />
<meta property="og:description" content="{{ og_description | default(description) }}" />
<meta property="og:type" content="website" />
<meta property="og:image" content="{{ og_image }}" />
<meta property="og:url" content="{{ og_url }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ twitter_title | default(title) }}" />
<meta name="twitter:description" content="{{ twitter_description | default(description) }}" />
<meta name="twitter:image" content="{{ twitter_image | default(og_image) }}" />
<link rel="canonical" href="{{ canonical }}" />
<link rel="alternate" hreflang="en" href="{{ hreflang_en }}" />
<link rel="alternate" hreflang="ga" href="{{ hreflang_ga }}" />
<link rel="alternate" hreflang="x-default" href="{{ hreflang_default | default(hreflang_en) }}" />
<link rel="icon" href="assets/img/irish-cross.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="assets/img/irish-cross.svg" />
<link rel="stylesheet" href="assets/dist/site.bundle.css" />
<link rel="stylesheet" href="assets/liturgy/liturgy-accent.css" />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "Alan Gallagher",
      "url": "https://alanwpgallagher.com/",
      "image": "https://alanwpgallagher.com/assets/img/alan-oxford-don.png",
      "jobTitle": "{{ job_title }}",
      "sameAs": ["https://www.linkedin.com/in/alan-gallagher-a3818a332"]
    },
    {
      "@type": "WebSite",
      "name": "{{ site_name }}",
      "url": "https://alanwpgallagher.com/",
      "publisher": {
        "@type": "Person",
        "name": "Alan Gallagher"
      }
    }
  ]
}
</script>
